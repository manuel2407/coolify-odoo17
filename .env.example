# Required for the integrated PostgreSQL service (compose)
# Set the same value in Coolify Environment Variables or in a local .env
DB_PASSWORD=change_this_db_password

# Odoo master password (/web/database/manager)
ADMIN_PASSWD=change_this_master_password

# Optional overrides
# DB_USER=odoo
# DB_NAME=odoo
# DB_HOST=db
